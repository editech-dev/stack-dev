# >>> stack-dev >>>
if [ -d "/usr/lib/jvm/java-25-openjdk-$(dpkg --print-architecture 2>/dev/null || echo amd64)" ]; then
    export JAVA_HOME="/usr/lib/jvm/java-25-openjdk-$(dpkg --print-architecture 2>/dev/null || echo amd64)"
elif command -v javac >/dev/null 2>&1; then
    export JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")"
fi
export ANDROID_HOME="$HOME/Android/Sdk"
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:${JAVA_HOME:+$JAVA_HOME/bin:}$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$HOME/flutter/bin:$PATH"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"
[ -x "$HOME/tools/jadx/bin/jadx" ] && alias jadx="$HOME/tools/jadx/bin/jadx"
# <<< stack-dev <<<
