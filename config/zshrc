# Deduplicar automáticamente PATH y FPATH en Zsh
typeset -U path PATH fpath FPATH

# Completions personalizadas (Deno, etc.)
[ -d "$HOME/.zsh/completions" ] && export FPATH="$HOME/.zsh/completions:$FPATH"

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="kali-like"
plugins=(git)
[ -s "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# Historial (aislado por sesión al cerrar)
unsetopt share_history
unsetopt inc_append_history
setopt append_history

# --- Binarios base del usuario y agentes ---
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$PATH"

# --- Java (Única versión LTS del sistema) & Android / Mobile ---
if [ -d "/usr/lib/jvm/java-25-openjdk-$(dpkg --print-architecture 2>/dev/null || echo amd64)" ]; then
    export JAVA_HOME="/usr/lib/jvm/java-25-openjdk-$(dpkg --print-architecture 2>/dev/null || echo amd64)"
elif command -v javac >/dev/null 2>&1; then
    export JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")"
fi

export ANDROID_HOME="$HOME/Android/Sdk"
export PATH="${JAVA_HOME:+$JAVA_HOME/bin:}$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$HOME/flutter/bin:$PATH"
[ -x "$HOME/tools/jadx/bin/jadx" ] && alias jadx="$HOME/tools/jadx/bin/jadx"

# --- Ecosistema JS / TS (NVM Node LTS, pnpm standalone, Bun, Deno) ---
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"

export BUN_INSTALL="$HOME/.bun"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
export PATH="$BUN_INSTALL/bin:$PATH"

export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"

# --- Anaconda3 (opcional: se activa solo si existe en el equipo) ---
if [ -d "$HOME/anaconda3" ]; then
    __conda_setup="$("$HOME/anaconda3/bin/conda" 'shell.zsh' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    elif [ -f "$HOME/anaconda3/etc/profile.d/conda.sh" ]; then
        . "$HOME/anaconda3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/anaconda3/bin:$PATH"
    fi
    unset __conda_setup
fi

# --- Extensiones locales privadas del usuario (no versionadas en git) ---
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
