#!/usr/bin/env bash
set -uo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✔${NC} $*"; }
warn() { echo -e "  ${YELLOW}⚠${NC} $*"; }
fail() { echo -e "  ${RED}✖${NC} $*"; }

echo -e "${BOLD}${CYAN}=== Auditoría del Stack de Desarrollo y Seguridad (dev-check) ===${NC}"

# 1. Runtimes principales y Herramientas IA
echo -e "\n${BOLD}1. Versiones y Fuentes Únicas:${NC}"

check_cmd() {
  local label="$1" cmd="$2" ver_cmd="$3"
  if command -v "$cmd" >/dev/null 2>&1; then
    local path ver
    path="$(command -v "$cmd")"
    ver="$(eval "$ver_cmd" 2>&1 | head -n 1)"
    ok "${BOLD}${label}:${NC} ${ver} ${CYAN}(${path})${NC}"
  else
    warn "${BOLD}${label}:${NC} no encontrado en PATH"
  fi
}

check_cmd "Node.js"  "node"     "node -v"
check_cmd "npm"      "npm"      "npm -v"
check_cmd "pnpm"     "pnpm"     "pnpm -v"
check_cmd "Bun"      "bun"      "bun -v"
check_cmd "Deno"     "deno"     "deno --version"
check_cmd "Java"     "java"     "java -version"
check_cmd "Javac"    "javac"    "javac -version"
if [ -f /opt/android-studio/product-info.json ]; then
  AS_VER="$(python3 -c 'import json; d=json.load(open("/opt/android-studio/product-info.json")); print(d.get("dataDirectoryName","AndroidStudio") + " (" + d.get("buildNumber","") + ") - JBR " + str(d.get("minRequiredJavaVersion","")))' 2>/dev/null || cat /opt/android-studio/build.txt)"
  ok "${BOLD}Android Studio:${NC} ${AS_VER} ${CYAN}(/opt/android-studio)${NC}"
else
  warn "${BOLD}Android Studio:${NC} no instalado en /opt/android-studio"
fi
check_cmd "Flutter"  "flutter"  "flutter --version"
check_cmd "scrcpy"   "scrcpy"   "scrcpy --version 2>/dev/null"
check_cmd "DBeaver"  "dbeaver"  "dpkg-query -W -f='DBeaver CE \${Version}\n' dbeaver-ce"
check_cmd "Docker"   "docker"   "docker --version"
check_cmd "Python3"  "python3"  "python3 --version"
check_cmd "uv"       "uv"       "uv --version"
check_cmd "Vercel"   "vercel"   "vercel --version"
check_cmd "Supabase" "supabase" "supabase --version"
check_cmd "AGY CLI"  "agy"      "agy --version"
check_cmd "OpenCode" "opencode" "opencode --version"
check_cmd "Claude"   "claude"   "claude --version"
check_cmd "Codex"    "codex"    "codex --version"

# 2. Conflictos de sombra en /usr/bin y coherencia Java
echo -e "\n${BOLD}2. Coherencia de Runtimes (Cero Duplicados Críticos):${NC}"

if [ -x /usr/bin/node ] || [ -x /usr/bin/npm ] || [ -x /usr/bin/corepack ]; then
  warn "Existen binarios antiguos de apt en /usr/bin (node/npm/corepack)."
else
  ok "Sin Node/npm/corepack viejos de apt en /usr/bin"
fi

if command -v java >/dev/null 2>&1 && command -v javac >/dev/null 2>&1; then
  JAVA_REAL="$(readlink -f "$(command -v java)")"
  JAVAC_REAL="$(readlink -f "$(command -v javac)")"
  JAVA_DIR="$(dirname "$JAVA_REAL")"
  JAVAC_DIR="$(dirname "$JAVAC_REAL")"
  if [ "$JAVA_DIR" = "$JAVAC_DIR" ]; then
    ok "java y javac unificados en la misma instalación (${JAVA_DIR})"
  else
    fail "Desfase detectado: java (${JAVA_DIR}) != javac (${JAVAC_DIR})"
  fi
else
  warn "Falta java o javac"
fi

# 3. Escudo Triple Supply-Chain (24h)
echo -e "\n${BOLD}3. Escudos contra Supply-Chain (Ventana mínima 24h):${NC}"

if grep -qE "^min-release-age=[1-9]" "$HOME/.npmrc" 2>/dev/null; then
  ok "npm (~/.npmrc): $(grep '^min-release-age=' "$HOME/.npmrc")"
else
  fail "npm (~/.npmrc): sin min-release-age activo"
fi

if grep -qE "^minimum-release-age=[1-9]" "$HOME/.config/pnpm/rc" 2>/dev/null; then
  ok "pnpm (~/.config/pnpm/rc): $(grep '^minimum-release-age=' "$HOME/.config/pnpm/rc"), $(grep '^ignore-scripts=' "$HOME/.config/pnpm/rc" 2>/dev/null || echo '')"
else
  fail "pnpm (~/.config/pnpm/rc): sin minimum-release-age activo"
fi

if grep -qE "minimumReleaseAge\s*=\s*[1-9]" "$HOME/.bunfig.toml" 2>/dev/null; then
  ok "Bun (~/.bunfig.toml): $(grep 'minimumReleaseAge' "$HOME/.bunfig.toml" | xargs)"
else
  fail "Bun (~/.bunfig.toml): sin minimumReleaseAge activo"
fi

# 4. Superficie del Host, PATH y Programación Automática
echo -e "\n${BOLD}4. Higiene de Entorno, Aislamiento y Auto-Update:${NC}"

DUPS="$(echo "$PATH" | tr ':' '\n' | sed '/^$/d' | sort | uniq -d)"
if [ -z "$DUPS" ]; then
  ok "PATH limpio (0 rutas duplicadas)"
else
  warn "Rutas duplicadas en PATH actual (abre nueva terminal Zsh): $(echo "$DUPS" | tr '\n' ' ')"
fi

if command -v php >/dev/null 2>&1; then
  warn "PHP detectado en el host ($(command -v php)). Se recomienda usar contenedores Docker efímeros."
else
  ok "Cero huella de PHP en el host (aislamiento seguro)"
fi

if systemctl --user is-active --quiet dev-update.timer 2>/dev/null; then
  LAST_RUN="pendiente primera corrida"
  [ -f "$HOME/.local/state/dev-update.last" ] && LAST_RUN="última vez: $(cat "$HOME/.local/state/dev-update.last")"
  ok "Auto-actualización diaria activa (systemd dev-update.timer — ${LAST_RUN})"
else
  warn "Timer diario dev-update.timer no está activo"
fi

# 5. Revisión contextual de Gradle si estamos en un proyecto Android/Flutter
WRAPPER_FILE=""
if [ -f "gradle/wrapper/gradle-wrapper.properties" ]; then
  WRAPPER_FILE="gradle/wrapper/gradle-wrapper.properties"
elif [ -f "android/gradle/wrapper/gradle-wrapper.properties" ]; then
  WRAPPER_FILE="android/gradle/wrapper/gradle-wrapper.properties"
fi

if [ -n "$WRAPPER_FILE" ]; then
  G_VER="$(grep -oE 'gradle-[0-9]+\.[0-9]+(\.[0-9]+)?' "$WRAPPER_FILE" | head -n1 | sed 's/gradle-//')"
  G_MAJOR="${G_VER%%.*}"
  if [ -n "$G_MAJOR" ] && [ "$G_MAJOR" -lt 9 ] 2>/dev/null; then
    warn "Proyecto local usa Gradle ${G_VER} (< 9.1.0). Para máxima compatibilidad con Java 25 y velocidad, actualízalo a Gradle 9.5.0."
  else
    ok "Proyecto local usa Gradle moderno (${G_VER})"
  fi
fi

echo ""
